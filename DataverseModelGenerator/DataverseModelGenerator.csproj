<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DataverseModelGenerator</RootNamespace>
    <AssemblyName>DataverseModelGenerator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls in Microsoft.Xrm.Sdk and Microsoft.Crm.Sdk.Proxy transitively.
         Version pinned to a known good release; check for a newer one with
         the dotnet CLI's "list package" outdated-check option if needed. -->
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.1.32" />
  </ItemGroup>

</Project>